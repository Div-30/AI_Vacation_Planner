# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vacation_planner

# ==========================================
# Auth / JWT Configuration
# ==========================================
SECRET_KEY=your_super_secret_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# LLM Provider Configuration
# ==========================================
# Which provider powers the itinerary agent's tool-calling loop.
# One of: "anthropic" | "google_genai"
LLM_PROVIDER=google_genai

# Model used by the itinerary agent (must belong to LLM_PROVIDER above)
LLM_MODEL=gemini-3.5-flash-lite

# Model used for voice trip extraction (app/services/voice_service.py).
# Must support multimodal audio input, since raw audio is sent to it directly.
VOICE_LLM_MODEL=gemini-3.8-flash

# API keys — only the key matching LLM_PROVIDER is strictly required,
# but you can set both if you want to switch providers without redeploying.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
